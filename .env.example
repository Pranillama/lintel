# Public. Safe to commit a placeholder; the real URL is written by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=

# Set the rest in the Convex dashboard. Actions read them there.
# Never prefix a secret with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
LINTEL_EXTRACT_MODEL=claude-haiku-5-5
LINTEL_INVESTIGATOR_MODEL=claude-sonnet-5-5
CREAO_API_KEY=
CREAO_AGENT_ID=
LINTEL_CRS_ENABLED=false
CRS_BASE_URL=
CRS_API_KEY=
LINTEL_X402_ENABLED=false

# Voice reviewer. Never prefix these with NEXT_PUBLIC_. The browser never sees the Cartesia key.
# Vercel only needs NEXT_PUBLIC_CONVEX_URL. The key and agent id live on the Convex deployment.
#
# Convex dashboard → Settings → Environment Variables (the voice action and the GET tools):
#   LINTEL_VOICE_TOOL_SECRET
#   CARTESIA_API_KEY
#   CARTESIA_REVIEWER_AGENT_ID
#
# Local shell or .env.local, for scripts/cartesia-setup.mjs (same secret and key as Convex):
#   LINTEL_VOICE_TOOL_SECRET
#   CARTESIA_API_KEY
#   CONVEX_SITE_URL
#   CARTESIA_REVIEWER_AGENT_ID   (after the first live run)
#   CARTESIA_AGENT_MODEL         (optional)
#   CARTESIA_VOICE_ID            (optional)
LINTEL_VOICE_TOOL_SECRET=

# Public Convex HTTP origin, no trailing slash. Example: https://happy-animal-123.convex.site
# Printed by `npx convex dev` / `npx convex deploy`. Used by the setup script. Not a secret.
CONVEX_SITE_URL=

# Same key in the Convex dashboard and in the local shell. Never on the Next.js client.
CARTESIA_API_KEY=

# Printed by the setup script. Required in the Convex dashboard so the bill page can mint a token.
# Also set it locally if you will run the script again and want it to update that agent.
CARTESIA_REVIEWER_AGENT_ID=

# Optional overrides for the setup script. See context/add-ons/cartesia-voice-setup.md.
CARTESIA_AGENT_MODEL=
CARTESIA_VOICE_ID=
