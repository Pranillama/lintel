# Public. Safe to commit a placeholder; the real URL is written by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=

# Set the rest in the Convex dashboard. Actions read them there.
# Never prefix a secret with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
LINTEL_EXTRACT_MODEL=claude-haiku-5-5
LINTEL_INVESTIGATOR_MODEL=claude-sonnet-5-5
CREAO_API_KEY=
CREAO_AGENT_ID=
LINTEL_CRS_ENABLED=false
CRS_BASE_URL=
CRS_API_KEY=
LINTEL_X402_ENABLED=false

# Voice reviewer. Set the bearer on the Convex deployment (dashboard → Environment Variables).
# Cartesia sends it as Authorization: Bearer <secret> on GET /voice/*.
# The setup script reads the same name from the environment so it can store it on the tool.
# Never commit a real value.
LINTEL_VOICE_TOOL_SECRET=

# Public Convex HTTP origin, no trailing slash. Example: https://happy-animal-123.convex.site
# Printed by `npx convex dev` / `npx convex deploy`. Used by scripts/cartesia-setup.mjs. Not a secret.
CONVEX_SITE_URL=

# Local only, for scripts/cartesia-setup.mjs. Do not put this on the Next.js client.
CARTESIA_API_KEY=

# Optional. Printed by the setup script. Set it to update that agent on the next run.
CARTESIA_REVIEWER_AGENT_ID=

# Optional. Used only with `node --experimental-strip-types scripts/cartesia-setup.mjs --phone`.
# Buy the number in the Cartesia dashboard first. The script does not buy one.
CARTESIA_PHONE_NUMBER_ID=

# Optional overrides. See context/add-ons/cartesia-voice-setup.md.
CARTESIA_AGENT_MODEL=
CARTESIA_VOICE_ID=
